{
  "name": "screenlink",
  "productName": "ScreenLink",
  "version": "0.3.0",
  "description": "Low-latency screen sharing between friends, relayed peer to peer",
  "private": true,
  "type": "module",
  "main": "client/main.js",
  "scripts": {
    "server": "bun run server/index.ts",
    "dev:server": "bun --watch server/index.ts",
    "start": "electron .",
    "test": "bun test",
    "postinstall": "bun node_modules/electron/install.js",
    "typecheck": "tsc --noEmit",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "electron": "^44.9.0",
    "electron-builder": "26.15.3",
    "typescript": "^5.9.0"
  },
  "trustedDependencies": [
    "electron"
  ],
  "author": {
    "name": "Diego Lincoln",
    "email": "diego@mutualtecnologia.com.br"
  },
  "homepage": "https://github.com/dilincoln/screenlink",
  "repository": {
    "type": "git",
    "url": "https://github.com/dilincoln/screenlink.git"
  },
  "build": {
    "appId": "io.github.dilincoln.screenlink",
    "productName": "ScreenLink",
    "files": [
      "client/**",
      "!client/**/*.test.js",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "artifactName": "ScreenLink-${version}-${os}-${arch}.${ext}",
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "pacman"
      ],
      "executableName": "screenlink",
      "icon": "build/icon.png",
      "category": "Network",
      "synopsis": "Low-latency screen sharing between friends",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "ScreenLink-${version}-win-setup.${ext}"
    },
    "portable": {
      "artifactName": "ScreenLink-${version}-win-portable.${ext}"
    },
    "publish": null
  },
  "desktopName": "screenlink.desktop"
}
